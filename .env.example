# Copiar a .env y completar. Nunca subir .env al repositorio.

# Host con el que los brokers se anuncian hacia fuera de Docker (puertos 9092-9094).
# Local: localhost. En EC2: IP publica o DNS de la instancia.
KAFKA_EXTERNAL_HOST=localhost

# Login de Kafka UI (http://<host>:8090). Generar la clave con: openssl rand -hex 16
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=cambiar_por_una_clave_aleatoria
